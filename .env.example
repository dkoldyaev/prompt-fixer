# ==============================================================================
# AI Prompt Rewriter - Environment Configuration
# All values must be explicitly set. Fallback defaults in code are prohibited.
# ==============================================================================

# PostgreSQL database connection URL
# Example: postgresql://postgres:postgres@localhost:5432/prompt_rewriter
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prompt_rewriter"

# OpenAI API Key (or "mock-key" for offline simulation & test execution)
OPENAI_API_KEY="mock-key"

# HTTP API server listening port (strictly integer, e.g. 3000)
API_PORT="3000"

# Public URL of the frontend application for CORS and absolute links
PUBLIC_APP_ORIGIN="http://localhost:3000"

# OpenAI Model identifier for Stage 1: Requirements Analyzer (Economy: gpt-6.1-terra, reasoning: medium)
OPENAI_ANALYZER_MODEL="gpt-6.1-terra"

# OpenAI Model identifier for Stage 2: Solution Architect (Quality: gpt-6.1-sol, reasoning: medium)
OPENAI_ARCHITECT_MODEL="gpt-6.1-sol"

# OpenAI Model identifier for Stage 3: Prompt Composer (Quality: gpt-6.1-sol, reasoning: medium)
OPENAI_COMPOSER_MODEL="gpt-6.1-sol"

# OpenAI Model identifier for Stage 4: Quality Reviewer (Economy: gpt-6.1-terra, reasoning: medium)
OPENAI_REVIEWER_MODEL="gpt-6.1-terra"

# OpenAI Model identifier for Fast Mode (single combined call: gpt-6.1-terra)
OPENAI_FAST_MODEL="gpt-6.1-terra"

# Maximum output tokens per LLM call (strictly integer)
AI_MAX_OUTPUT_TOKENS="8192"

# Retry count for transient network or rate limit errors (strictly integer)
AI_RETRY_LIMIT="3"

# Request timeout in milliseconds (strictly integer)
AI_REQUEST_TIMEOUT_MS="180000"

# Maximum allowable cost in USD per prompt rewrite job (strictly numeric)
AI_MAX_JOB_COST="3.00"

# Logging level: debug | info | warn | error
LOG_LEVEL="info"
